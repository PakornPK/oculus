{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development (macOS)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_OSX_SYSROOT": "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX26.sdk",
        "BUILD_TESTS": "ON",
        "BUILD_DEMO": "OFF"
      }
    },
    {
      "name": "linux-arm64",
      "displayName": "Linux ARM64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "BUILD_TESTS": "OFF",
        "BUILD_DEMO": "OFF"
      }
    },
    {
      "name": "linux-x86_64",
      "displayName": "Linux x86_64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x86_64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64",
        "BUILD_TESTS": "OFF",
        "BUILD_DEMO": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}